{
  "entities": {
    "UserHistoryEntry": {
      "title": "UserHistoryEntry",
      "description": "Saved browsing or reservation activity entry owned by a signed-in shopper.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["soap", "bath-bomb", "marble-case", "order"]
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "priceThb": {
          "type": "number"
        },
        "viewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "itemId", "itemType", "title", "viewedAt"]
    },
    "UserOrderRecord": {
      "title": "UserOrderRecord",
      "description": "Persisted concierge order confirmation, payment status, and tracking saved for an authenticated customer.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "totalThb": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "summaryTitle": {
          "type": "string",
          "maxLength": 200
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["queued", "molding", "batching", "curing", "packing", "shipped"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending", "cod", "refunded"]
        },
        "paidAtMs": {
          "type": "number"
        },
        "paymentReference": {
          "type": "string",
          "maxLength": 80
        },
        "trackingCode": {
          "type": "string",
          "maxLength": 48
        },
        "carrier": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "orderNumber", "totalThb", "itemCount", "summaryTitle", "paymentMethod", "createdAt"]
    },
    "AtelierOrder": {
      "title": "AtelierOrder",
      "description": "Full itemized customer order queued for atelier manufacturing, payment verification, tracking, and dispatch.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "shippingAddress": {
          "type": "string",
          "maxLength": 300
        },
        "gpsLabel": {
          "type": "string",
          "maxLength": 64
        },
        "engravingNote": {
          "type": "string",
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 64
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending", "cod", "refunded"]
        },
        "paidAtMs": {
          "type": "number"
        },
        "paymentReference": {
          "type": "string",
          "maxLength": 80
        },
        "trackingCode": {
          "type": "string",
          "maxLength": 48
        },
        "carrier": {
          "type": "string",
          "maxLength": 64
        },
        "items": {
          "type": "array"
        },
        "subtotalThb": {
          "type": "number"
        },
        "shippingThb": {
          "type": "number"
        },
        "totalThb": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["queued", "molding", "batching", "curing", "packing", "shipped"]
        },
        "completedSteps": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "customerName",
        "customerEmail",
        "shippingAddress",
        "paymentMethod",
        "items",
        "subtotalThb",
        "shippingThb",
        "totalThb",
        "status",
        "completedSteps",
        "createdAt",
        "updatedAt"
      ]
    },
    "MailingSubscriber": {
      "title": "MailingSubscriber",
      "description": "Email notification and site-update mailing list subscription.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "lang": {
          "type": "string",
          "enum": ["th", "en"]
        },
        "topics": {
          "type": "array"
        },
        "adCookiesAccepted": {
          "type": "boolean"
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "lang", "topics", "adCookiesAccepted", "createdAt"]
    },
    "SiteCounter": {
      "title": "SiteCounter",
      "description": "Public storefront aggregate count of reserved & sold artisanal items.",
      "type": "object",
      "properties": {
        "totalSold": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["totalSold", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/history/{entryId}": {
      "schema": { "$ref": "#/entities/UserHistoryEntry" },
      "description": "Private saved viewing and interaction history belonging to userId."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/UserOrderRecord" },
      "description": "Private saved order confirmations and payment/tracking status belonging to userId."
    },
    "/atelier_orders/{orderId}": {
      "schema": { "$ref": "#/entities/AtelierOrder" },
      "description": "Itemized customer production orders readable only by bootstrapped Atelier admins or the purchasing owner."
    },
    "/mailing_list/{subscriberId}": {
      "schema": { "$ref": "#/entities/MailingSubscriber" },
      "description": "Mailing list opt-in entries for site updates and product launches (write-only for public, admin-only read)."
    },
    "/site_metrics/{metricId}": {
      "schema": { "$ref": "#/entities/SiteCounter" },
      "description": "Publicly readable sold counter metrics."
    }
  }
}
