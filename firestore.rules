rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ipedmaak@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserHistory(data, userId) {
      return data.keys().hasAll(['uid', 'itemId', 'itemType', 'title', 'viewedAt'])
        && data.keys().hasOnly(['uid', 'itemId', 'itemType', 'title', 'subtitle', 'imageUrl', 'priceThb', 'viewedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 128 && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.itemType is string && data.itemType in ['soap', 'bath-bomb', 'marble-case', 'order']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 200))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && (!('priceThb' in data) || (data.priceThb is number && data.priceThb >= 0 && data.priceThb <= 500000))
        && data.viewedAt == request.time;
    }

    function isValidUserOrder(data, userId) {
      return data.keys().hasAll(['uid', 'orderNumber', 'totalThb', 'itemCount', 'summaryTitle', 'paymentMethod', 'createdAt'])
        && data.keys().hasOnly([
          'uid',
          'orderNumber',
          'totalThb',
          'itemCount',
          'summaryTitle',
          'paymentMethod',
          'status',
          'paymentStatus',
          'paidAtMs',
          'paymentReference',
          'trackingCode',
          'carrier',
          'createdAt'
        ])
        && data.uid is string && data.uid == userId
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.totalThb is number && data.totalThb >= 0 && data.totalThb <= 1000000
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100
        && data.summaryTitle is string && data.summaryTitle.size() >= 1 && data.summaryTitle.size() <= 200
        && data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 64
        && (!('status' in data) || (data.status is string && data.status in ['queued', 'molding', 'batching', 'curing', 'packing', 'shipped']))
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['paid', 'pending', 'cod', 'refunded']))
        && (!('paidAtMs' in data) || (data.paidAtMs is number && data.paidAtMs >= 0))
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 80))
        && (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 48))
        && (!('carrier' in data) || (data.carrier is string && data.carrier.size() <= 64))
        && data.createdAt is timestamp;
    }

    function isValidAtelierOrder(data, orderId) {
      return data.keys().hasAll([
          'orderNumber',
          'customerName',
          'customerEmail',
          'shippingAddress',
          'paymentMethod',
          'items',
          'subtotalThb',
          'shippingThb',
          'totalThb',
          'status',
          'completedSteps',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber',
          'accountId',
          'customerUid',
          'customerName',
          'customerEmail',
          'shippingAddress',
          'gpsLabel',
          'engravingNote',
          'paymentMethod',
          'paymentStatus',
          'paidAtMs',
          'paymentReference',
          'trackingCode',
          'carrier',
          'items',
          'subtotalThb',
          'shippingThb',
          'totalThb',
          'status',
          'completedSteps',
          'createdAt',
          'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber == orderId && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 128 && data.accountId.matches('^[a-zA-Z0-9_\\-]+$')))
        && (!('customerUid' in data) || (data.customerUid is string && data.customerUid.size() <= 128 && data.customerUid.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 160 && data.customerEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.shippingAddress is string && data.shippingAddress.size() >= 2 && data.shippingAddress.size() <= 300
        && (!('gpsLabel' in data) || (data.gpsLabel is string && data.gpsLabel.size() <= 64))
        && (!('engravingNote' in data) || (data.engravingNote is string && data.engravingNote.size() <= 80))
        && data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 64
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['paid', 'pending', 'cod', 'refunded']))
        && (!('paidAtMs' in data) || (data.paidAtMs is number && data.paidAtMs >= 0))
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 80))
        && (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 48))
        && (!('carrier' in data) || (data.carrier is string && data.carrier.size() <= 64))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30 && data.items[0] is map
        && data.subtotalThb is number && data.subtotalThb >= 0 && data.subtotalThb <= 2000000
        && data.shippingThb is number && data.shippingThb >= 0 && data.shippingThb <= 50000
        && data.totalThb is number && data.totalThb >= 0 && data.totalThb <= 2050000
        && data.status is string && data.status in ['queued', 'molding', 'batching', 'curing', 'packing', 'shipped']
        && data.completedSteps is list && data.completedSteps.size() <= 200 && (data.completedSteps.size() == 0 || data.completedSteps[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidMailingSubscriber(data) {
      return data.keys().hasAll(['email', 'lang', 'topics', 'adCookiesAccepted', 'createdAt'])
        && data.keys().hasOnly(['email', 'lang', 'topics', 'adCookiesAccepted', 'uid', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.lang is string && data.lang in ['th', 'en']
        && data.topics is list && data.topics.size() >= 1 && data.topics.size() <= 6 && data.topics[0] is string
        && data.adCookiesAccepted is bool
        && (!('uid' in data) || (isVerifiedUser() && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid))
        && data.createdAt == request.time;
    }

    function isValidSiteCounter(data) {
      return data.keys().hasAll(['totalSold', 'updatedAt'])
        && data.keys().hasOnly(['totalSold', 'updatedAt'])
        && data.totalSold is number && data.totalSold >= 1428 && data.totalSold <= 9999999
        && data.updatedAt == request.time;
    }

    match /users/{userId}/history/{entryId} {
      allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isValidUserHistory(incoming(), userId);
      allow update: if isValidId(userId) && isValidId(entryId) && isOwner(userId)
        && isValidUserHistory(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().itemId == existing().itemId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'imageUrl', 'priceThb', 'viewedAt']);
      allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
    }

    match /users/{userId}/orders/{orderId} {
      allow get: if isValidId(userId) && isValidId(orderId) && (isOwner(userId) || isAdmin());
      allow list: if (isOwner(userId) && resource.data.uid == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isValidId(userId) && isValidId(orderId)
        && isOwner(userId)
        && isValidUserOrder(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && (!('trackingCode' in incoming()))
        && (!('status' in incoming()) || incoming().status == 'queued')
        && (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['pending', 'cod', 'paid']);
      allow update: if isValidId(userId) && isValidId(orderId)
        && isAdmin()
        && isValidUserOrder(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'paidAtMs', 'paymentReference', 'trackingCode', 'carrier']);
      allow delete: if isValidId(userId) && isValidId(orderId) && isAdmin();
    }

    match /atelier_orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && resource.data.customerUid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.customerUid == request.auth.uid);
      allow create: if isValidId(orderId)
        && isValidAtelierOrder(incoming(), orderId)
        && incoming().status == 'queued'
        && incoming().completedSteps.size() == 0
        && (!('trackingCode' in incoming()))
        && incoming().createdAt == request.time
        && (!('customerUid' in incoming()) || (isVerifiedUser() && incoming().customerUid == request.auth.uid));
      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidAtelierOrder(incoming(), orderId)
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && ((!('customerUid' in existing()) && !('customerUid' in incoming()))
          || (('customerUid' in existing()) && ('customerUid' in incoming()) && incoming().customerUid == existing().customerUid))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'completedSteps',
          'paymentStatus',
          'paidAtMs',
          'paymentReference',
          'trackingCode',
          'carrier',
          'updatedAt'
        ]);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /mailing_list/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidMailingSubscriber(incoming());
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow update, delete: if isValidId(subscriberId) && isAdmin();
    }

    match /site_metrics/{metricId} {
      allow get: if isValidId(metricId);
      allow create: if isValidId(metricId) && metricId == 'counters' && isVerifiedUser() && isValidSiteCounter(incoming());
      allow update: if isValidId(metricId) && metricId == 'counters' && isVerifiedUser()
        && isValidSiteCounter(incoming())
        && incoming().totalSold >= existing().totalSold
        && incoming().totalSold <= existing().totalSold + 50
        && incoming().diff(existing()).affectedKeys().hasOnly(['totalSold', 'updatedAt']);
      allow list, delete: if false;
    }
  }
}
